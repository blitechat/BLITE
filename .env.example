# BLITE Environment Configuration
# Copy this file to .env and fill in the values.
# For self-hosting, run `bash setup.sh` instead — it generates .env automatically.

# ── Client (Vite) ────────────────────────────────────────────────────────────
VITE_API_URL=https://your-domain.com/api
VITE_SOCKET_URL=https://your-domain.com

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
SERVER_URL=https://your-domain.com
JWT_SECRET=          # REQUIRED — generate with: openssl rand -base64 48
CORS_ORIGIN=https://your-domain.com
NODE_ENV=production

# Mode: 'full' (voice + video) or 'lite' (text only)
BLITE_MODE=full

# ── mediasoup (only needed in full mode) ──────────────────────────────────────
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=   # Your server's public IP
MEDIASOUP_RTC_MIN_PORT=40000
MEDIASOUP_RTC_MAX_PORT=40100
MEDIASOUP_NUM_WORKERS=auto

# ── Push Notifications (optional) ─────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain.com

# ── Docker (used by docker-compose.yml) ───────────────────────────────────────
BLITE_PORT=3001
# DOMAIN=your-domain.com   # Uncomment if using Caddy for HTTPS
