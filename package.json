{
  "name": "blite",
  "version": "2.2.3",
  "description": "Privacy-first encrypted messaging platform",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "build:web": "vite build --config vite.config.web.ts",
    "build:electron:prod": "cross-env VITE_API_URL=https://blite.chat/api VITE_SOCKET_URL=https://blite.chat electron-vite build",
    "build:portable:win": "npm run build:electron:prod && electron-builder --win --dir && node scripts/zip-portable.js",
    "generate:icons": "node scripts/generate-icons.js",
    "build:installer:win": "npm run generate:icons && npm run build:electron:prod && electron-builder --win",
    "build:installer:mac": "npm run generate:icons && npm run build:electron:prod && electron-builder --mac",
    "build:installer:linux": "npm run generate:icons && npm run build:electron:prod && electron-builder --linux",
    "build:installer": "npm run generate:icons && npm run build:electron:prod && electron-builder --win --linux",
    "generate:updates": "node scripts/generate-update-files.js",
    "release": "npm run build:installer && node scripts/copy-release.js && npm run generate:updates",
    "dev:server": "cd server && npm run dev",
    "dev:all": "concurrently \"npm run dev:server\" \"npm run dev\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "axios": "^1.7.0",
    "date-fns": "^3.6.0",
    "electron-updater": "^6.7.3",
    "immer": "^11.1.4",
    "lucide-react": "^0.427.0",
    "mediasoup-client": "^3.18.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "socket.io-client": "^4.7.5",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "archiver": "^7.0.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^31.4.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.41",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
